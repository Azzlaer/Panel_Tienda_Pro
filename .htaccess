Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:config|app|database|storage|partials)(?:/|$) - [F,L,NC]
</IfModule>
<FilesMatch "^(?:\.env(?:\..*)?|composer\.(?:json|lock)|README(?:_[^/]*)?\.md|.*\.(?:sql|log|bak|backup|ini|dist)|installed\.lock)$">
Require all denied
</FilesMatch>
