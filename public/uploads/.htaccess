# Uploaded user content must never be executed as application code.
Options -Indexes -ExecCGI
<FilesMatch "(?i)\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml|asp|aspx|jsp|htaccess|htpasswd)(?:\..*)?$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
